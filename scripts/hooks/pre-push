#!/usr/bin/env bash
# Generic pre-push hook: run full local validation before allowing a push, so
# GitHub Action minutes are only spent on the merge-time/post-merge gate, not on
# broken pushes. Auto-detects the repo's stack.
#
# Install: git config core.hooksPath scripts/hooks   (or: make install-hooks)
# Escape hatch: git push --no-verify
set -euo pipefail

# `git push` opens the connection to the remote BEFORE running this hook, so
# every second spent validating here leaves that connection idle and GitHub
# eventually closes it ("Connection to github.com closed by remote host").
# scripts/safe-push.sh calls this hook with --validate-only FIRST, records the
# commit that passed, and only then pushes; the stamp check below lets the real
# hook return in seconds. Prefer `make push`. Do NOT reach for --no-verify: the
# supply-chain guard runs at the bottom of this file, so bypassing a TRANSPORT
# problem would silently bypass a SECURITY check.
VALIDATE_ONLY=false
[ "${1:-}" = "--validate-only" ] && VALIDATE_ONLY=true

PUSHING_SHA=""
if ! $VALIDATE_ONLY; then
  ZERO=0000000000000000000000000000000000000000
  deleting_only=true
  while read -r _l local_sha _r _rs; do
    [ "$local_sha" != "$ZERO" ] && deleting_only=false
    [ "$local_sha" != "$ZERO" ] && PUSHING_SHA="$local_sha"
  done
  $deleting_only && exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# git EXPORTS its repository pointers to hooks, and this hook runs a test suite.
# Anything that shells out to `git` inherits them, and an ambient GIT_DIR
# outranks cwd — that combination once wrote into the operator's own
# .git/config. Cleared after the cd so the hook still resolves its own repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH

STAMP=".git/prepush-validated"
if ! $VALIDATE_ONLY && [ -n "$PUSHING_SHA" ] && [ -f "$STAMP" ] \
   && [ "$(cat "$STAMP" 2>/dev/null)" = "$PUSHING_SHA" ]; then
  echo "── pre-push: ✓ $(printf '%.12s' "$PUSHING_SHA") already validated by safe-push — pushing ──"
  exit 0
fi

if ! $VALIDATE_ONLY; then
  echo "   NOTE: validating inside the hook holds the remote connection open and can"
  echo "         fail with 'Connection to github.com closed by remote host'."
  echo "         Prefer: make push"
fi
echo "── pre-push: full local validation ──"

# Prefer a repo-defined target if present (internal has `make ci-local`).
if [ -f Makefile ] && grep -qE '^ci-local:' Makefile; then
  make ci-local; echo "── pre-push: ✓ ──"; exit 0
fi

fail() { echo "── pre-push: ✗ $1 — push blocked (git push --no-verify to override) ──"; exit 1; }

# Python backend (ruff + mypy + pytest) where a venv + sources exist.
if [ -x .venv/bin/ruff ]; then
  echo "[pre-push] python · ruff";  .venv/bin/ruff check . || fail "ruff"
  [ -x .venv/bin/mypy ] && { echo "[pre-push] python · mypy"; .venv/bin/mypy . || fail "mypy"; }
  if [ -x .venv/bin/pytest ]; then
    echo "[pre-push] python · pytest"
    .venv/bin/pytest -x -q -p no:cacheprovider -m "not benchmark_slo and not preservation" || fail "pytest"
  fi
fi

# Node frontend (lint + typecheck + tests) where a package.json exists.
for pkg in package.json src/web/package.json; do
  [ -f "$pkg" ] || continue
  dir=$(dirname "$pkg")
  echo "[pre-push] node · $dir (lint/typecheck/test)"
  ( cd "$dir" && \
    { ! grep -q '"lint"' package.json || npm run -s lint; } && \
    { ! grep -q '"typecheck"' package.json || npm run -s typecheck; } && \
    { ! grep -q '"test"' package.json || npm test --silent -- --run 2>/dev/null || npx vitest run; } ) || fail "node:$dir"
done

# Supply-chain guard (always, where present).
[ -f scripts/guard-no-ai-commits.sh ] && { echo "[pre-push] supply-chain guard"; bash scripts/guard-no-ai-commits.sh || fail "guard"; }

echo "── pre-push: ✓ local validation passed ──"
